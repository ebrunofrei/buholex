# Asegura que todos los archivos de texto usen LF al hacer commit
* text=auto eol=lf

# Fuerza uso de LF para ciertos archivos comunes
*.js     text eol=lf
*.ts     text eol=lf
*.json   text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.sh     text eol=lf

# Evita cambios innecesarios por el sistema operativo
*.ico    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.webp   binary
*.svg    text

# Para Firebase y archivos Vercel
firebase.json text eol=lf
vercel.json   text eol=lf

# No normalizar archivos de credenciales ni certificados
*.key  -text
*.pem  -text
*.p12  -text
*.crt  -text
*.env* -text
